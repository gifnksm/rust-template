#!/usr/bin/env bash

set -euo pipefail

declare SCRIPTS_DIR
SCRIPTS_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"

declare -a TMP_FILES=()
trap 'rm -rf "${TMP_FILES[@]}"' EXIT

ok() {
    printf "\033[32m[OK]\033[0m %s\n" "$*" >&2
}

error() {
    printf "\033[31m[ERROR]\033[0m %s\n" "$*" >&2
}

check_command_exists() {
    local cmd="$1"
    command -v "${cmd}" &>/dev/null || {
        error "${cmd} is not installed."
        return 1
    }
}

main() {
    [[ "$#" -eq 3 ]] || {
        echo "Usage: $0 <owner> <repo> <crate_type>" >&2
        exit 1
    }

    local owner="$1"
    local repo="$2"
    local crate_type="$3"

    [[ "${crate_type}" == "bin" ]] || [[ "${crate_type}" == "lib" ]] || {
        error "invalid crate type '${crate_type}'. Must be 'bin' or 'lib'."
        exit 1
    }

    check_command_exists "gh" || return 1
    check_command_exists "jq" || return 1

    gh auth status &>/dev/null || {
        error "you are not authenticated with GitHub CLI. Please run 'gh auth login'."
        return 1
    }

    local workdir
    workdir="$(mktemp -d)" || return 1
    TMP_FILES+=("${workdir}")

    local checklist_file="${SCRIPTS_DIR}/../etc/expected-rulesets-${crate_type}.json"
    ! [[ -f "${checklist_file}" ]] && {
        error "checklist file not found: ${checklist_file}"
        return 1
    }

    local ruleset_index
    ruleset_index="${workdir}/rulesets.json"
    gh api --paginate "/repos/${owner}/${repo}/rulesets" |
        jq -s 'add // []' >"${ruleset_index}" || return 1

    check_all_rulesets "${checklist_file}" "${owner}" "${repo}" "${ruleset_index}" || return 1
}

check_all_rulesets() {
    local checklist_file="$1"
    local owner="$2"
    local repo="$3"
    local ruleset_index="$4"

    local ruleset_names_txt
    ruleset_names_txt="$(jq -r '.[].ruleset_name' "${checklist_file}")" || return 1
    local -a ruleset_names
    readarray -t ruleset_names <<<"${ruleset_names_txt}"

    local status=0
    local ruleset_name
    for ruleset_name in "${ruleset_names[@]}"; do
        local ruleset_id
        ruleset_id="$(jq -r --arg ruleset_name "${ruleset_name}" '
            [ .[] | select(.name == $ruleset_name) | .id ]
            | if length == 0 then
                error("Ruleset not found: " + $ruleset_name)
            elif length > 1 then
                error("Multiple rulesets found: " + $ruleset_name)
            else
                .[0]
            end
        ' "${ruleset_index}")" || {
            status=1
            continue
        }

        echo "Checking ruleset: ${ruleset_name} (ID: ${ruleset_id})" >&2
        local checks
        checks="$(jq -r --arg ruleset_name "${ruleset_name}" '.[] | select(.ruleset_name == $ruleset_name) | .checks' "${checklist_file}")" || {
            status=1
            continue
        }
        local actual_ruleset
        actual_ruleset="$(gh api "/repos/${owner}/${repo}/rulesets/${ruleset_id}")" || {
            status=1
            continue
        }
        check_ruleset "${checks}" "${actual_ruleset}" || {
            status=1
            continue
        }
    done

    return "${status}"
}

check_ruleset() {
    local checks="$1"
    local actual_ruleset="$2"

    local queries_txt
    queries_txt="$(jq -r '.[].query' <<<"${checks}")" || return 1
    local -a queries
    readarray -t queries <<<"${queries_txt}"

    local status=0
    local i
    for i in "${!queries[@]}"; do
        local query="${queries[i]}"
        local expected_value
        expected_value="$(jq -c --arg query "${query}" '.[] | select(.query == $query) | .value' <<<"${checks}")" || {
            status=1
            continue
        }
        local actual_value
        actual_value="$(jq -c "${query}" <<<"${actual_ruleset}")" || {
            status=1
            continue
        }

        local jd_output
        jd_output="$(jd <(echo "${actual_value}") <(echo "${expected_value}"))" || {
            error "'${query}'" >&2
            echo "expected: ${expected_value}" >&2
            echo "actual:   ${actual_value}" >&2
            echo "diff:" >&2
            echo "${jd_output}" >&2
            status=1
            continue
        }
        ok "'${query}'" >&2
    done

    return "${status}"
}

main "$@"
