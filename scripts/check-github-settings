#!/usr/bin/env bash

set -euo pipefail

declare SCRIPTS_DIR
SCRIPTS_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
DATASET_DIR="${SCRIPTS_DIR}/../etc"

ok() {
    printf "\033[32m[OK]\033[0m %s\n" "$*" >&2
}

error() {
    printf "\033[31m[ERROR]\033[0m %s\n" "$*" >&2
}

check_command_exists() {
    local cmd="$1"
    command -v "${cmd}" &>/dev/null || {
        error "${cmd} is not installed."
        return 1
    }
}

main() {
    [[ "$#" -eq 4 ]] || [ "$#" -eq 3 ] || {
        echo "Usage: $0 <owner> <repo> <crate_type> [<target>]" >&2
        return 1
    }

    local owner="$1"
    local repo="$2"
    local crate_type="$3"
    local target="${4:-all}"

    [[ "${crate_type}" == "bin" ]] || [[ "${crate_type}" == "lib" ]] || {
        error "invalid crate type '${crate_type}'. Must be 'bin' or 'lib'."
        return 1
    }

    check_command_exists "gh" || return 1
    check_command_exists "jq" || return 1

    gh auth status &>/dev/null || {
        error "you are not authenticated with GitHub CLI. Please run 'gh auth login'."
        return 1
    }

    gh api --silent "/repos/${owner}/${repo}" &>/dev/null || {
        error "repository '${owner}/${repo}' does not exist or you do not have access."
        return 1
    }

    local status=0
    case "${target}" in
    "rulesets")
        check_rulesets "${owner}" "${repo}" "${crate_type}" || status=1
        ;;
    "immutable-releases")
        check_immutable_releases "${owner}" "${repo}" || status=1
        ;;
    environments)
        check_environments "${owner}" "${repo}" || status=1
        ;;
    "all")
        check_rulesets "${owner}" "${repo}" "${crate_type}" || status=1
        check_immutable_releases "${owner}" "${repo}" || status=1
        check_environments "${owner}" "${repo}" || status=1
        ;;
    *)
        error "invalid target: ${target}"
        return 1
        ;;
    esac
    return "${status}"
}

check_rulesets() {
    local owner="$1"
    local repo="$2"
    local crate_type="$3"

    local checklist_file="${DATASET_DIR}/expected-rulesets-${crate_type}.json"
    [[ -f "${checklist_file}" ]] || {
        error "checklist file not found: ${checklist_file}"
        return 1
    }

    local num_checklists
    num_checklists="$(jq 'length' "${checklist_file}")" || {
        error "failed to read checklist file: ${checklist_file}"
        return 1
    }

    local existing_rulesets
    existing_rulesets="$(gh api --paginate "/repos/${owner}/${repo}/rulesets" | jq -s 'add // []')" || {
        error "failed to fetch ruleset index from GitHub API"
        return 1
    }

    local status=0
    local i
    for ((i = 0; i < num_checklists; i++)); do
        local checklist
        checklist="$(jq -c --argjson i "${i}" '.[$i]' "${checklist_file}")" || {
            status=1
            error "failed to extract checklist at index ${i} from checklist file"
            continue
        }

        local ruleset_name
        ruleset_name="$(jq -r '.ruleset_name // error("ruleset_name is null or missing")' <<<"${checklist}")" || {
            status=1
            error "failed to extract ruleset name from checklist at index ${i}"
            continue
        }

        local ruleset_id
        ruleset_id="$(jq -r --arg ruleset_name "${ruleset_name}" '
            [ .[] | select(.name == $ruleset_name) | .id ]
            | if length == 0 then
                error("ruleset not found: " + $ruleset_name)
            elif length > 1 then
                error("multiple rulesets found: " + $ruleset_name)
            else
                .[0]
            end
        ' <<<"${existing_rulesets}")" || {
            status=1
            error "failed to get ruleset id for ruleset '${ruleset_name}'"
            continue
        }

        echo "Checking ruleset for ${owner}/${repo}: ${ruleset_name} (ID: ${ruleset_id})" >&2

        local checks
        checks="$(jq -c '.checks // error("checks is null or missing")' <<<"${checklist}")" || {
            status=1
            error "failed to extract checks for ruleset '${ruleset_name}' from checklist"
            continue
        }

        local actual_data
        actual_data="$(gh api "/repos/${owner}/${repo}/rulesets/${ruleset_id}")" || {
            status=1
            error "failed to fetch ruleset '${ruleset_name}' from GitHub API"
            continue
        }

        check_values "${owner}" "${repo}" "${checks}" "${actual_data}" || {
            status=1
            continue
        }
    done

    return "${status}"
}

check_immutable_releases() {
    local owner="$1"
    local repo="$2"

    echo "Checking immutable releases for ${owner}/${repo}" >&2

    local checklist_file="${DATASET_DIR}/expected-immutable-releases.json"
    [[ -f "${checklist_file}" ]] || {
        error "checklist file not found: ${checklist_file}"
        return 1
    }

    local checks
    checks="$(cat "${checklist_file}")" || {
        error "failed to read checklist file: ${checklist_file}"
        return 1
    }

    local actual_data
    actual_data="$(gh api "/repos/${owner}/${repo}/immutable-releases")" || {
        error "failed to fetch release information from GitHub API"
        return 1
    }

    check_values "${owner}" "${repo}" "${checks}" "${actual_data}" || return 1
}

check_environments() {
    local owner="$1"
    local repo="$2"

    local checklist_file="${DATASET_DIR}/expected-environments.json"
    [[ -f "${checklist_file}" ]] || {
        error "checklist file not found: ${checklist_file}"
        return 1
    }

    local num_checklists
    num_checklists="$(jq 'length' "${checklist_file}")" || {
        error "failed to read checklist file: ${checklist_file}"
        return 1
    }

    local status=0
    local i
    for ((i = 0; i < num_checklists; i++)); do
        local checklist
        checklist="$(jq -c --argjson i "${i}" '.[$i]' "${checklist_file}")" || {
            status=1
            error "failed to extract checklist at index ${i} from checklist file"
            continue
        }

        local environment_name
        environment_name="$(jq -r '.environment_name // error(".environment_name is null or missing")' <<<"${checklist}")" || {
            status=1
            error "failed to extract environment name from checklist at index ${i}"
            continue
        }

        echo "Checking environments for ${owner}/${repo}: ${environment_name}" >&2

        local checks
        checks="$(jq -c '.checks // error(".checks is null or missing")' <<<"${checklist}")" || {
            status=1
            error "failed to extract checks for environment '${environment_name}' from checklist"
            continue
        }

        local actual_data
        actual_data="$(gh api "/repos/${owner}/${repo}/environments/${environment_name}")" || {
            status=1
            error "failed to fetch environment '${environment_name}' from GitHub API"
            continue
        }

        check_values "${owner}" "${repo}" "${checks}" "${actual_data}" || {
            status=1
            continue
        }

        local checks
        checks="$(jq -c '.deployment_branch_policies // error(".deployment_branch_policies is null or missing")' <<<"${checklist}")" || {
            status=1
            error "failed to extract deployment branch policies for environment '${environment_name}' from checklist"
            continue
        }

        local actual_data
        actual_data="$(gh api "/repos/${owner}/${repo}/environments/${environment_name}/deployment-branch-policies")" || {
            status=1
            error "failed to fetch environment deployment branch policies '${environment_name}' from GitHub API"
            continue
        }

        check_values "${owner}" "${repo}" "${checks}" "${actual_data}" || {
            status=1
            continue
        }
    done

    return "${status}"
}

check_values() {
    local owner="$1"
    local repo="$2"
    local checks="$3"
    local actual_data="$4"

    local queries_txt
    queries_txt="$(jq -r '.[].query' <<<"${checks}")" || {
        error "failed to extract queries from checks"
        return 1
    }
    local -a queries
    readarray -t queries <<<"${queries_txt}"

    local status=0
    local i
    for i in "${!queries[@]}"; do
        local query="${queries[i]}"
        local expected_value
        expected_value="$(jq -c --arg query "${query}" '.[] | select(.query == $query) | .value' <<<"${checks}")" || {
            status=1
            error "failed to extract expected value for query '${query}'"
            continue
        }
        local actual_value
        actual_value="$(jq -c "${query}" --arg owner "${owner}" --arg repo "${repo}" <<<"${actual_data}")" || {
            status=1
            error "failed to extract actual value for query '${query}'"
            continue
        }

        local jd_output
        jd_output="$(jd <(echo "${actual_value}") <(echo "${expected_value}"))" || {
            error "'${query}'" >&2
            echo "expected: ${expected_value}" >&2
            echo "actual:   ${actual_value}" >&2
            echo "diff:" >&2
            echo "${jd_output}" >&2
            status=1
            continue
        }
        ok "'${query}'" >&2
    done

    return "${status}"
}

main "$@"
