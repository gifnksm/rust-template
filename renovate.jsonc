{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],

  "minimumReleaseAge": "3 days",

  // Override Cargo's default rangeStrategy so direct dependency updates also
  // refresh Cargo.toml instead of only updating Cargo.lock.
  "cargo": {
    "rangeStrategy": "bump",
    "managerFilePatterns": ["/^template/Cargo(\\.(bin|lib))?\\.toml$/"]
  },

  "packageRules": [
    {
      "description": "Group compatible Cargo updates",
      "matchManagers": ["cargo"],
      "matchCurrentVersion": "!/^0\\./",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Cargo compatible dependencies"
    },
    {
      "description": "Group compatible 0.1+ Cargo patch updates",
      "matchManagers": ["cargo"],
      "matchCurrentVersion": "/^0\\.[1-9]\\d*\\./",
      "matchUpdateTypes": ["patch"],
      "groupName": "Cargo compatible dependencies"
    }
  ]
}
