{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],

  "minimumReleaseAge": "3 days",
  "labels": ["dependencies"],

  // Override Cargo's default rangeStrategy so direct dependency updates also
  // refresh Cargo.toml instead of only updating Cargo.lock.
  "cargo": {
    "rangeStrategy": "bump",
    "managerFilePatterns": ["/^template/Cargo(\\.(bin|lib))?\\.toml$/"]
  },

  "packageRules": [
    {
      "description": "Disable mise lock file maintenance",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "enabled": false
    }
  ]
}
